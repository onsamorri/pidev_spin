<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="604.0" prefWidth="915.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.AddTrainingSession">
    <children>
        <BorderPane layoutX="-2.0" prefHeight="605.0" prefWidth="913.0">
            <left>
                <VBox prefHeight="605.0" prefWidth="170.0" style="-fx-background-color: #709775;" BorderPane.alignment="CENTER">
                    <children>
                        <Button mnemonicParsing="false" prefHeight="43.0" prefWidth="170.0" style="-fx-background-color: #709775;" text="1" textFill="WHITE" />
                        <Button mnemonicParsing="false" prefHeight="43.0" prefWidth="170.0" style="-fx-background-color: #709775;" text="2" textFill="WHITE" />
                        <Button mnemonicParsing="false" prefHeight="43.0" prefWidth="170.0" style="-fx-background-color: #709775;" text="3" textFill="WHITE" />
                        <Button mnemonicParsing="false" prefHeight="43.0" prefWidth="170.0" style="-fx-background-color: #709775;" text="4" textFill="WHITE" />
                        <Button mnemonicParsing="false" prefHeight="43.0" prefWidth="170.0" style="-fx-background-color: #709775;" text="Performance Data" textFill="WHITE" />
                        <Button mnemonicParsing="false" prefHeight="43.0" prefWidth="170.0" style="-fx-background-color: #709775;" text="Training Session" textFill="WHITE" />
                    </children>
                </VBox>
            </left>
            <top>
                <HBox prefHeight="71.0" prefWidth="838.0" style="-fx-background-color: #463F3A;" BorderPane.alignment="CENTER" />
            </top>
            <center>
                <VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="10" BorderPane.alignment="CENTER">
                    <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Add Training Session" />
                        <ChoiceBox id="training_focus" fx:id="training_focus" prefWidth="300.0" />
                        <ChoiceBox id="training_duration" fx:id="training_duration" prefWidth="300.0" />
                        <TextField fx:id="training_location" prefHeight="30.0" prefWidth="250.0" promptText="Location" />
                        <TextField fx:id="training_start_time" prefHeight="30.0" prefWidth="250.0" promptText="Start Time (HH:MM)" />
                        <TextField fx:id="training_notes" prefHeight="30.0" prefWidth="586.0" promptText="Notes" />
                        <Button onAction="#addTrainingSession" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: #709775; -fx-text-fill: white; -fx-font-size: 14px;" text="Submit" />
                        <VBox spacing="10" />
                        <TableView fx:id="trainingTable" prefHeight="200.0" prefWidth="600.0">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="122.0" text="Session Id" />
                                <TableColumn fx:id="colFocus" prefWidth="150.0" text="Focus" />
                                <TableColumn fx:id="colStartTime" prefWidth="120.0" text="Start Time" />
                                <TableColumn fx:id="colDuration" prefWidth="100.0" text="Duration" />
                                <TableColumn fx:id="colLocation" prefWidth="150.0" text="Location" />
                                <TableColumn fx:id="colNotes" prefWidth="200.0" text="Notes" />
                                <TableColumn fx:id="colActions" prefWidth="150.0" text="Actions" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
