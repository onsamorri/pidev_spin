<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #E0E0E0;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.MyInjuriesController">

    <!-- Sidebar Menu from Second File -->
    <VBox prefHeight="600.0" prefWidth="178.0" style="-fx-background-color: #709775;">
        <VBox alignment="CENTER" prefHeight="91.0" prefWidth="230.0">
            <ImageView fitHeight="87.0" fitWidth="71.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@logo.png" />
            </ImageView>
        </VBox>

        <HBox alignment="CENTER" prefHeight="38.0" prefWidth="157.0" />
        <HBox alignment="CENTER" prefHeight="38.0" prefWidth="157.0">
            <Label prefHeight="38.0" prefWidth="110.0" style="-fx-font-size: 20px; -fx-font-family: 'Calibri Bold';"
                   text="View Team" textAlignment="RIGHT" textFill="WHITE"/>
        </HBox>
        <HBox alignment="CENTER" prefHeight="38.0" prefWidth="157.0">
            <Label prefHeight="38.0" prefWidth="163.0" style="-fx-font-size: 19px; -fx-font-family: 'Calibri Bold';"
                   text="Training Sessions" textFill="WHITE"/>
        </HBox>
        <HBox alignment="CENTER" prefHeight="38.0" prefWidth="157.0">
            <Label prefHeight="38.0" prefWidth="170.0" style="-fx-font-size: 19px; -fx-font-family: 'Calibri Bold';"
                   text="Performance Data" textFill="WHITE"/>
        </HBox>
        <Label prefHeight="34.0" prefWidth="149.0" style="-fx-font-size: 18px; -fx-font-family: 'Calibri Bold'; -fx-background-radius: 10; -fx-alignment: center;" text="Claims" textFill="WHITE" />

        <Label fx:id="BackButton" alignment="CENTER" prefHeight="46.0" prefWidth="172.0" style="-fx-font-size: 16px; -fx-font-family: 'Calibri Bold'; -fx-background-radius: 10; -fx-padding: 10;" text="Back to Dashboard" textFill="WHITE" />
    </VBox>

    <!-- Injury List Section (Dynamically Filled) -->
    <VBox fx:id="injuryListVBox" layoutX="198.0" layoutY="163.0" prefHeight="337.0" prefWidth="559.0" spacing="20.0">
        <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </VBox.margin>

        <!-- Placeholder for Injury and Recovery Plan Cards -->
    </VBox>

    <!-- Header Section -->
    <VBox alignment="CENTER" layoutX="320.0" layoutY="64.0" prefHeight="50.0" prefWidth="316.0" style="-fx-background-color: #D57F4F; -fx-background-radius: 15px;">
        <Label style="-fx-font-size: 24px; -fx-font-family: 'Calibri'; -fx-font-weight: bold;" text="My Injury and Recovery Plan" textFill="WHITE" />
    </VBox>

</AnchorPane>