        </Text>
        <Text fx:id="retypenewpassword_text" fill="WHITE" layoutX="157.0" layoutY="387.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Re-type your new password:">
            <font>
                <Font name="Montserrat Regular" size="20.0" />
            </font>
        </Text>
        <PasswordField fx:id="newpass_input" layoutX="157.0" layoutY="333.0" prefHeight="35.0" prefWidth="325.0" style="-fx-background-color: #709775; -fx-border-color: white; -fx-border-radius: 100; -fx-text-fill: white; -fx-border-width: 2;" />
        <PasswordField fx:id="retypenewpass_input" layoutX="156.0" layoutY="399.0" prefHeight="35.0" prefWidth="325.0" style="-fx-border-color: black; -fx-text-fill: white; -fx-border-color: white; -fx-background-color: #709775; -fx-border-radius: 100; -fx-border-width: 2;" />
