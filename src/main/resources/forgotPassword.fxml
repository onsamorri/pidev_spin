<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="412.0" prefWidth="660.0" style="-fx-background-color: #709775;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.forgotPassword">
    <children>
        <Text fill="WHITE" layoutX="157.0" layoutY="53.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Forgot Password?">
            <font>
                <Font name="Dubai Bold" size="40.0" />
            </font>
        </Text>
        <TextField fx:id="email_input" layoutX="153.0" layoutY="95.0" prefHeight="35.0" prefWidth="330.0" style="-fx-border-color: white; -fx-border-radius: 100; -fx-background-color: #709775; -fx-border-width: 2; -fx-text-fill: white;" />
        <Button layoutX="153.0" layoutY="138.0" mnemonicParsing="false" onAction="#send_email" prefHeight="35.0" prefWidth="330.0" style="-fx-border-color: white; -fx-border-radius: 100; -fx-background-color: #709775; -fx-border-width: 2;" text="Send instruction" textFill="WHITE">
            <font>
                <Font name="Montserrat SemiBold" size="15.0" />
            </font>
        </Button>
        <Text fill="WHITE" layoutX="173.0" layoutY="87.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Please type in your E-mail:">
            <font>
                <Font name="Montserrat Regular" size="25.0" />
            </font>
        </Text>
        <TextField fx:id="generatedcode_input" layoutX="153.0" layoutY="211.0" prefHeight="35.0" prefWidth="330.0" style="-fx-border-color: white; -fx-background-color: #709775; -fx-border-radius: 100; -fx-border-width: 2; -fx-text-fill: white;" />
        <Text fx:id="generatedcode_text" fill="WHITE" layoutX="153.0" layoutY="199.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Please put your generated code:">
            <font>
                <Font name="Montserrat Regular" size="20.0" />
            </font>
        </Text>
        <Button fx:id="verify_button" layoutX="153.0" layoutY="256.0" mnemonicParsing="false" onAction="#verify_button" prefHeight="35.0" prefWidth="330.0" style="-fx-border-color: white; -fx-border-radius: 100; -fx-background-color: #709775; -fx-border-width: 2;" text="Verify" textFill="WHITE">
            <font>
                <Font name="Montserrat SemiBold" size="15.0" />
            </font>
        </Button>
        <Button fx:id="submitpass_button" layoutX="157.0" layoutY="449.0" mnemonicParsing="false" onAction="#submitpass_button" prefHeight="35.0" prefWidth="325.0" style="-fx-border-color: white; -fx-border-radius: 100; -fx-background-color: #709775; -fx-border-width: 2;" text="Submit" textFill="WHITE">
            <font>
                <Font name="Montserrat SemiBold" size="15.0" />
            </font>
        </Button>
        <Text fx:id="newpassword_text" fill="WHITE" layoutX="157.0" layoutY="320.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Please enter your new password:">
