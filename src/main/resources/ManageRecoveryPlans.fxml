<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import java.net.URL?>
<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Controllers.ShowRecoveryPlanController">
    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>
    <children>
        <BorderPane prefHeight="600.0" prefWidth="900.0">
            <top>
                <HBox prefHeight="80.0" prefWidth="900.0" styleClass="header" BorderPane.alignment="CENTER">
                    <Label text="Manage Recovery Plans" styleClass="header-title" />
                </HBox>
            </top>
            <left>
                <!-- Include Sidebar.fxml -->
                <fx:include source="SideBar.fxml" />
            </left>
            <center>
                <VBox alignment="CENTER" spacing="10" styleClass="form-grid" BorderPane.alignment="CENTER">
                    <TableView fx:id="RecoveryTable" prefHeight="500.0" prefWidth="700.0">
                        <columns>
                            <TableColumn fx:id="RecoveryIdColumn" text="Recovery ID" />
                            <TableColumn fx:id="AthleteFirstNameColumn" text="Athlete First Name" />
                            <TableColumn fx:id="AthleteLastNameColumn" text="Athlete Last Name" />
                            <TableColumn fx:id="RecoveryGoalColumn" text="Recovery Goals" />
                            <TableColumn fx:id="RecoveryDescriptionColumn" text="Description" />
                            <TableColumn fx:id="RecoveryStartDateColumn" text="Start Date" />
                            <TableColumn fx:id="RecoveryEndDateColumn" text="End Date" />
                            <TableColumn fx:id="RecoveryStatusColumn" text="Recovery Status" />
                        </columns>
                    </TableView>
                </VBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
