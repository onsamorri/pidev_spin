<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.UpdatePerformance">
    <VBox spacing="10" alignment="CENTER" layoutX="20" layoutY="20">
        <Label text="Update Performance" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <HBox spacing="10">
            <Label text="Speed:"/>
            <TextField fx:id="performance_speed"/>
        </HBox>

        <HBox spacing="10">
            <Label text="Agility:"/>
            <TextField fx:id="performance_agility"/>
        </HBox>

        <HBox spacing="10">
            <Label text="Goals:"/>
            <TextField fx:id="performance_nbr_goals"/>
        </HBox>

        <HBox spacing="10">
            <Label text="Assists:"/>
            <TextField fx:id="performance_assists"/>
        </HBox>

        <HBox spacing="10">
            <Label text="Fouls:"/>
            <TextField fx:id="performance_nbr_fouls"/>
        </HBox>

        <HBox spacing="10">
            <Label text="Date Recorded:"/>
            <DatePicker fx:id="performance_date_recorded"/>
        </HBox>

        <Button fx:id="updateButton" text="Update" onAction="#updatePerformance"/>
    </VBox>
</AnchorPane>
