<AnchorPane prefHeight="585.0" prefWidth="790.0" style="-fx-background-color: #709775;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.ShowTrainingSessionFrontController">

    <children>
