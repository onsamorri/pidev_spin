<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import java.net.URL?>
<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Controllers.ShowClaimController">
    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>
    <children>
        <BorderPane prefHeight="600.0" prefWidth="900.0">
            <top>
                <HBox prefHeight="80.0" prefWidth="900.0" styleClass="header" BorderPane.alignment="CENTER">
                    <Label text="Manage Claims" styleClass="header-title" />
                </HBox>
            </top>
            <left>
                <VBox prefHeight="600.0" prefWidth="200.0" styleClass="sidebar" BorderPane.alignment="CENTER">
                    <children>
                        <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="200.0" text="Dashboard" styleClass="sidebar-button" />
                        <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="200.0" text="Claims" styleClass="sidebar-button" />
                        <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="206.0" text="Claim Actions" styleClass="sidebar-button" />
                        <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="206.0" text="Reports" styleClass="sidebar-button" />
                        <Button mnemonicParsing="false" prefHeight="26.0" prefWidth="214.0" text="Logout" styleClass="sidebar-button" />
                    </children>
                    <opaqueInsets>
                        <Insets />
                    </opaqueInsets>
                </VBox>
            </left>
            <center>
                <VBox alignment="CENTER" spacing="10" styleClass="form-grid" BorderPane.alignment="CENTER">
                    <TableView fx:id="claimsTable" prefHeight="500.0" prefWidth="700.0">
                        <columns>
                            <TableColumn fx:id="claimIdColumn" text="ID" />
                            <TableColumn fx:id="claimDescriptionColumn" text="Description" />
                            <TableColumn fx:id="claimStatusColumn" text="Status" />
                            <TableColumn fx:id="claimDateColumn" text="Date" />
                            <TableColumn fx:id="claimCategoryColumn" text="Category" />
                            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="250" />
                        </columns>
                    </TableView>
                </VBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>