<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>

<?import java.net.URL?>
<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Controllers.UpdateClaimActionController">
    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>
    <children>
        <BorderPane prefHeight="600.0" prefWidth="900.0">
            <top>
                <HBox prefHeight="80.0" prefWidth="900.0" styleClass="header" BorderPane.alignment="CENTER">
                    <Label text="Update Claim Action" styleClass="header-title" />
                </HBox>
            </top>
            <left>
                <VBox prefHeight="600.0" prefWidth="200.0" styleClass="sidebar" BorderPane.alignment="CENTER">
                    <children>
                        <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="200.0" text="Dashboard" styleClass="sidebar-button" />
                        <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="200.0" text="Claims" styleClass="sidebar-button" />
                        <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="206.0" text="Claim Actions" styleClass="sidebar-button" />
                        <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="206.0" text="Reports" styleClass="sidebar-button" />
                        <Button mnemonicParsing="false" prefHeight="26.0" prefWidth="214.0" text="Logout" styleClass="sidebar-button" />
                    </children>
                    <opaqueInsets>
                        <Insets />
                    </opaqueInsets>
                </VBox>
            </left>
            <center>
                <GridPane alignment="CENTER" hgap="10" vgap="10" styleClass="form-grid" BorderPane.alignment="CENTER">
                    <columnConstraints>
                        <ColumnConstraints minWidth="150.0" />
                        <ColumnConstraints minWidth="250.0" />
                    </columnConstraints>
                    <children>
                        <!-- Labels and Inputs -->
                        <Label text="Claim ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label" />
                        <TextField fx:id="claimIdField" promptText="Enter claim ID" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="form-input" prefWidth="300.0" />

                        <Label text="Action Type:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label" />
                        <ChoiceBox fx:id="claimActionTypeBox" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="form-input" prefWidth="300.0" />

                        <Label text="Start Date:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label" />
                        <DatePicker fx:id="claimActionStartDatePicker" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="form-input" prefWidth="300.0" />

                        <Label text="End Date:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label" />
                        <DatePicker fx:id="claimActionEndDatePicker" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="form-input" prefWidth="300.0" />

                        <Label text="Notes:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="form-label" />
                        <TextField fx:id="claimActionNotesField" promptText="Enter notes" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="form-input" prefWidth="300.0" />

                        <!-- Update and Cancel Buttons -->
                        <HBox spacing="10" GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.halignment="RIGHT">
                            <Button fx:id="updateClaimActionButton" text="Update Claim Action" styleClass="form-button" />
                            <Button fx:id="cancelButton" text="Cancel" styleClass="form-button" />
                        </HBox>
                    </children>
                </GridPane>
            </center>
        </BorderPane>
    </children>
</AnchorPane>