<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Controllers.ShowClaimActionController">
    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>
    <children>
        <BorderPane prefHeight="600.0" prefWidth="900.0">
            <top>
                <HBox prefHeight="80.0" prefWidth="900.0" styleClass="header" BorderPane.alignment="CENTER">
                    <Label text="Manage Claim Actions" styleClass="header-title" />
                </HBox>
            </top>
            <left>
                <VBox prefHeight="600.0" prefWidth="200.0" styleClass="sidebar" BorderPane.alignment="CENTER">
                    <children>
                        <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="200.0" text="Dashboard" styleClass="sidebar-button" />
                        <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="200.0" text="Claims" styleClass="sidebar-button" />
                        <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="206.0" text="Claim Actions" styleClass="sidebar-button" />
                        <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="206.0" text="Reports" styleClass="sidebar-button" />
                        <Button mnemonicParsing="false" prefHeight="26.0" prefWidth="214.0" text="Logout" styleClass="sidebar-button" />
                    </children>
                    <opaqueInsets>
                        <Insets />
                    </opaqueInsets>
                </VBox>
            </left>
            <center>
                <VBox alignment="CENTER" spacing="10" styleClass="content" BorderPane.alignment="CENTER">
                    <children>
                        <TableView fx:id="claimActionsTable" prefHeight="500.0" prefWidth="800.0">
                            <columns>
                                <TableColumn fx:id="claimActionIdColumn" text="ID">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="claimActionId" />
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn fx:id="claimIdColumn" text="Claim ID">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="claimId" />
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn fx:id="claimActionTypeColumn" text="Action Type">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="claimActionType" />
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn fx:id="claimActionStartDateColumn" text="Start Date">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="claimActionStartDate" />
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn fx:id="claimActionEndDateColumn" text="End Date">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="claimActionEndDate" />
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn fx:id="claimActionNotesColumn" text="Notes">
                                    <cellValueFactory>
                                        <PropertyValueFactory property="claimActionNotes" />
                                    </cellValueFactory>
                                </TableColumn>
                                <TableColumn fx:id="actionsColumn" text="Actions">
                                    <!-- Cell factory and other configurations -->
                                </TableColumn>
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>